APP_PORT=8081
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_DB=posts
DATABASE_URL=postgres://app:secret@localhost:5433/posts?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25
DATABASE_CONN_MAX_LIFETIME=5m

# выбор хранилища inmemory или psql
STORAGE_TYPE=inmemory

MAX_COMMENT_BODY_SIZE=2000